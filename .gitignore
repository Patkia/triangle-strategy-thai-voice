# GitHub-safe repository: deny by default, then allow only reviewed source/docs/data.
*
!.gitignore
!README.md
!AGENTS.md

!scripts/
!scripts/**/*.py
!scripts/**/*.ps1
!tools/
!tools/**/*.py
!data/
!data/*.safe.csv
!docs/
!docs/github-readiness-audit.md
!docs/github-safe-curation.md

# Always keep local, even if a future allowlist is expanded.
/TRIANGLE STRATEGY */
/subthai/
/men/
/Output/

# Allow Git to enter work/
!/work/

# Ignore everything inside work by default
/work/*

# Track every chapter voice mapping folder
# Allow chapter mapping folders
!/work/chapter*_voice_mapping/

# Track only canonical chapter files
!/work/chapter*_voice_mapping/chapter*_omnivoice_studio.csv
!/work/chapter*_voice_mapping/build_chapter*_omnivoice_csv.py
!/work/chapter*_voice_mapping/chapter*_build_report.json

# Shared builders
!/work/chapter*_common_builder.py

# Track shared chapter builders
!/work/chapter*_common_builder.py

/vgmstream-win64/
/FModel.exe
*.pak
*.uasset
*.uexp
*.ubulk
*.awb
*.acb
*.hca
*.wav
*.lub
*.nso
*.ufont
*.utoc
*.ucas
*.dds

# Local credentials/configuration and editor/tool caches.
.env
.env.*
*.pem
*.pfx
*.ppk
secrets.*
__pycache__/
*.pyc
